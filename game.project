[project]
title = Appodeal Demo
version = 0.1
write_log = 1
dependencies#0 = https://github.com/andsve/dirtylarry/archive/master.zip

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 1280
height = 720

[physics]
scale = 0.02

[ios]
bundle_identifier = com.appodeal.testing

[script]
shared_state = 1

[android]
package = com.defold.adtest
minimum_sdk_version = 21

[native_extension]
app_manifest = /game.appmanifest

[library]
include_dirs = appodeal

